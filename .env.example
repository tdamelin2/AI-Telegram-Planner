# Copy this file to .env and fill it in (start.bat does the copy on first run).
# Never commit .env. Every value below is a placeholder or a default setting.

# ===== Claude: Muse, Warden and the Synthesizer =====
# How Claude is paid for: "plan" = your Claude subscription (sign in with start.bat --login-claude),
# "api" = pay-per-use API key below
CLAUDE_AUTH=plan
# Anthropic API key; only read when CLAUDE_AUTH=api, ignored in plan mode
ANTHROPIC_API_KEY=

# ===== Codex: Forge and Axiom =====
# Optional OpenAI API key; leave empty to sign in with ChatGPT via start.bat --login-codex
OPENAI_API_KEY=

# ===== Telegram (create each bot with @BotFather) =====
# Host bot: receives your commands and posts status messages
HOST_BOT_TOKEN=
# Bot that posts Muse's turns
MUSE_BOT_TOKEN=
# Bot that posts Warden's turns
WARDEN_BOT_TOKEN=
# Bot that posts Forge's turns
FORGE_BOT_TOKEN=
# Bot that posts Axiom's turns
AXIOM_BOT_TOKEN=
# Numeric id of the group the bots post to (find it with start.bat --whoami)
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to send commands (find yours with start.bat --whoami)
ALLOWED_USER_IDS=

# ===== Models =====
# Model for Muse and Warden: an alias (opus / sonnet / haiku) or a full model id
CLAUDE_MODEL=sonnet
# Model for the Claude research subagents
CLAUDE_RESEARCH_MODEL=sonnet
# Model for the Synthesizer that writes the final plan
SYNTH_MODEL=sonnet
# Model for Forge and Axiom; empty = your Codex account default
CODEX_MODEL=

# ===== Phase 1: structured debate =====
# Maximum critique rounds before the debate ends
P1_MAX_CRITIQUE_ROUNDS=2
# Word limit for each proposal
P1_PROPOSAL_MAX_WORDS=900
# Seconds allowed for each agent call
P1_CALL_TIMEOUT_S=420
# Maximum tool round trips per Claude call (research included)
P1_MAX_TURNS=12

# ===== Phase 2: creativity round (per-agent caps are in planner/personas/<name>.py) =====
# Maximum messages in the whole round
P2_MAX_TOTAL_MESSAGES=12
# Time window for the round, in seconds
P2_WINDOW_S=600
# Seconds allowed for each Phase 2 agent call
P2_CALL_TIMEOUT_S=180

# ===== Synthesis =====
# Seconds allowed for the Synthesizer to write the final plan
SYNTH_TIMEOUT_S=600

# ===== Safety =====
# Dollar cap per run, only enforced when CLAUDE_AUTH=api
CLAUDE_BUDGET_USD_PER_RUN=15
# How many times you can send /revise notes on a draft
MAX_HUMAN_REVISIONS=2
# Largest input Markdown file accepted, in bytes
MAX_INPUT_BYTES=400000
# Minimum seconds between posts from one bot (keeps each bot under Telegram's limit)
TELEGRAM_MIN_GAP_S=3.2
